<div
  class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8"
  data-controller="redact"
>
  <!-- Header -->
  <header class="mb-6 pb-4 dark:border-slate-700">
    <div class="text-center">
      <h1 class="text-2xl sm:text-4xl font-bold text-slate-900 mb-2 dark:font-semibold dark:text-slate-100">
        Redactor
      </h1>
      <p class="text-slate-700 text-md font-medium dark:font-normal dark:text-slate-400">
        Redact sensitive text before pasting into ChatGPT or other AI. Nothing is stored.
      </p>
      <p class="mt-2 text-md text-slate-600 font-medium dark:font-normal dark:text-slate-400">
        Try:
        <a href="#" class="text-blue-600 hover:text-blue-700 hover:underline transition-colors dark:text-blue-400 dark:hover:text-blue-300" data-action="redact#loadExample" data-example="1">Simple example</a>,
        <a href="#" class="text-blue-600 hover:text-blue-700 hover:underline transition-colors dark:text-blue-400 dark:hover:text-blue-300" data-action="redact#loadExample" data-example="2">Clinical note</a>,
        <a href="#" class="text-blue-600 hover:text-blue-700 hover:underline transition-colors dark:text-blue-400 dark:hover:text-blue-300" data-action="redact#loadExample" data-example="3">Insurance appeal</a>
      </p>
    </div>
  </header>
  <!-- Controls -->
  <section class="mb-6 border-2 border-slate-300 bg-slate-200 rounded-lg p-4 dark:border-slate-700 dark:bg-slate-900/50">
    <div class="flex flex-wrap items-center gap-3">
      <button
        type="button"
        class="px-4 py-2 text-sm font-semibold bg-blue-600 hover:bg-blue-700 text-white rounded shadow-sm transition-colors dark:font-medium"
        data-action="redact#run"
      >
        Redact
      </button>

      <button
        type="button"
        class="px-4 py-2 text-sm font-semibold bg-slate-300 hover:bg-slate-400 text-slate-900 rounded shadow-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed dark:font-medium dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-slate-200"
        data-action="redact#copy"
        data-redact-target="copyBtn"
        disabled
      >
        Copy redacted
      </button>

      <button
        type="button"
        class="px-4 py-2 text-sm font-semibold bg-slate-300 hover:bg-slate-400 text-slate-900 rounded shadow-sm transition-colors dark:font-medium dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-slate-200"
        data-action="redact#clear"
      >
        Clear
      </button>

      <span
        class="inline-flex items-center gap-1.5 border-2 border-slate-400 bg-slate-200 rounded-full px-3 py-1 text-xs font-semibold text-slate-700 transition-colors ml-auto dark:border dark:border-slate-600 dark:bg-slate-800/50 dark:font-medium dark:text-slate-300"
        data-redact-target="statusPill"
        data-kind="idle"
      >
        <span class="h-1.5 w-1.5 rounded-full"></span>
      </span>
    </div>

    <details class="group mt-4">
      <summary class="cursor-pointer text-slate-900 text-sm font-semibold hover:text-slate-950 transition-colors list-none dark:font-medium dark:text-slate-200 dark:hover:text-slate-100">
        <span class="inline-block mr-2 text-slate-600 dark:text-slate-400">▶</span>
        Custom words to redact (optional)
      </summary>
      <div class="mt-3 pt-3 dark:border-slate-700">
        <input
          type="text"
          class="w-full bg-white border-2 border-slate-400 rounded px-3 py-2 text-sm font-medium text-slate-900 placeholder:text-slate-500 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500/50 transition-colors dark:border dark:bg-slate-800/50 dark:border-slate-600 dark:font-normal dark:text-slate-200"
          placeholder="Comma-separated terms (e.g., client names, codenames)"
          data-redact-target="dictionary"
        />
        <p class="mt-2 text-xs text-slate-600 font-medium dark:font-normal dark:text-slate-400">
          Force-redact specific terms that aren't automatically detected
        </p>
      </div>
    </details>
  </section>

  <!-- Two panes -->
  <main class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <!-- Left pane -->
    <section class="flex flex-col overflow-hidden border-2 border-slate-300 bg-slate-200 rounded-lg shadow-sm dark:border-slate-700 dark:bg-slate-900/30">
      <div class="border-b-2 border-slate-300 bg-slate-300 px-4 py-2.5 rounded-t-lg dark:border-slate-700 dark:bg-slate-800/50">
        <h2 class="text-sm font-bold text-slate-900 dark:font-medium dark:text-slate-200">
          Paste text
        </h2>
      </div>

      <textarea
        class="h-76 w-full resize-y border-0 px-4 py-3 text-sm font-medium leading-relaxed bg-white text-slate-900 placeholder:text-slate-600 focus:ring-0 focus:outline-none focus:bg-slate-50 focus:ring-2 focus:ring-blue-500/30 transition-colors rounded-b-lg dark:font-normal dark:bg-slate-900/50 dark:text-slate-100 dark:placeholder:text-slate-500 dark:focus:bg-slate-900/70 dark:focus:ring-0"
        placeholder="Paste your text here..."
        spellcheck="false"
        data-redact-target="input"
        data-action="input->redact#onInput"
      ></textarea>
    </section>

    <!-- Right pane -->
    <section class="flex flex-col overflow-hidden border-2 border-slate-300 bg-slate-200 rounded-lg shadow-sm dark:border-slate-700 dark:bg-slate-900/30">
      <div class="border-b-2 border-slate-300 bg-slate-300 px-4 py-2.5 rounded-t-lg flex items-center justify-between dark:border-slate-700 dark:bg-slate-800/50">
        <h2 class="text-sm font-bold text-slate-900 dark:font-medium dark:text-slate-200">
          Redacted output
        </h2>
        <button
          type="button"
          class="px-3 py-1.5 text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white rounded shadow-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed dark:font-medium"
          data-action="redact#copy"
          data-redact-target="copyBtn"
          disabled
        >
          Copy redacted
        </button>
      </div>

      <textarea
        class="h-76 w-full resize-y border-0 px-4 py-3 text-sm font-medium leading-relaxed bg-white text-slate-900 placeholder:text-slate-600 focus:ring-0 focus:outline-none rounded-b-lg dark:font-normal dark:bg-slate-900/50 dark:text-slate-100 dark:placeholder:text-slate-500"
        placeholder="Redacted text will appear here..."
        spellcheck="false"
        readonly
        data-redact-target="output"
        aria-label="Redacted text"
      ></textarea>

      <details class="border-t-2 border-slate-300 bg-slate-200 rounded-b-lg group dark:border-slate-700 dark:bg-slate-800/30">
        <summary class="cursor-pointer px-4 py-3 text-sm font-semibold text-slate-900 hover:text-slate-950 transition-colors list-none flex items-center justify-between dark:font-medium dark:text-slate-200 dark:hover:text-slate-100">
          <span>What we redacted</span>
          <span class="text-xs font-medium text-slate-600 dark:font-normal dark:text-slate-400" data-redact-target="meta"></span>
        </summary>
        <div class="px-4 pb-3 pt-0">
          <div
            class="space-y-2 text-xs"
            data-redact-target="findings"
          >
            <div class="text-slate-600 font-medium italic dark:font-normal dark:text-slate-400">No detections yet.</div>
          </div>
        </div>
      </details>
    </section>
  </main>

  <!-- Footer Tips -->
  <footer class="mt-8 pt-6 border-t-2 border-slate-300 dark:border-slate-700">
    <h2 class="text-sm font-bold uppercase tracking-wide text-slate-700 mb-3 dark:text-slate-300">Usage tips</h2>
    <ul class="space-y-1.5 text-sm font-medium text-slate-700 pl-5 list-disc dark:text-slate-400">
      <li>We detect emails, phones, SSNs, names, and more. Add custom terms in Custom dictionary.</li>
      <li>Nothing is stored; processing is real-time.</li>
    </ul>
  </footer>

  <!-- Use cases -->
  <section class="mt-8 pt-6 border-t-2 border-slate-300 dark:border-slate-700">
    <h2 class="text-sm font-bold uppercase tracking-wide text-slate-700 mb-3 dark:text-slate-300">Who this is for</h2>
    <p class="text-sm font-medium text-slate-700 mb-4 dark:text-slate-400">
      Professionals who want to use AI tools (e.g. ChatGPT, Claude) for drafts, research, or analysis must avoid pasting confidential or privileged material into LLMs. Redactor strips identifying information so you can safely use the result in AI—without changing your workflow.
    </p>
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <li class="rounded-lg border-2 border-slate-300 bg-slate-200 p-4 text-sm font-medium text-slate-700 shadow-sm dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-400">
        <span class="mb-1 block font-bold text-slate-900 dark:text-slate-200">Lawyers</span>
        Redact client names, case details, and other privileged or identifying information before using text in AI-assisted research or drafting.
      </li>
      <li class="rounded-lg border-2 border-slate-300 bg-slate-200 p-4 text-sm font-medium text-slate-700 shadow-sm dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-400">
        <span class="mb-1 block font-bold text-slate-900 dark:text-slate-200">Doctors & healthcare</span>
        Remove patient names, contact details, and identifiers so you can discuss anonymized clinical scenarios with AI.
      </li>
      <li class="rounded-lg border-2 border-slate-300 bg-slate-200 p-4 text-sm font-medium text-slate-700 shadow-sm dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-400">
        <span class="mb-1 block font-bold text-slate-900 dark:text-slate-200">Accountants & finance</span>
        Strip client names, account numbers, and other sensitive data before asking LLMs for analysis or advice.
      </li>
      <li class="rounded-lg border-2 border-slate-300 bg-slate-200 p-4 text-sm font-medium text-slate-700 shadow-sm dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-400">
        <span class="mb-1 block font-bold text-slate-900 dark:text-slate-200">Other professionals</span>
        Consultants, HR, and anyone handling confidential text can redact it first, then paste the result into any LLM.
      </li>
    </ul>
    <p class="mt-4 text-sm font-medium text-slate-600 dark:text-slate-500">
      No database: we don’t store your input or redacted output. Processing happens in your session; nothing is saved.
    </p>
  </section>
</div>
