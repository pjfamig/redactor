<div
  class="mx-auto max-w-7xl px-4 py-6"
  data-controller="redact"
>
  <!-- Header -->
  <header class="mb-6">
    <h1 class="text-xl font-semibold text-gray-900">
      Prompt Redactor
    </h1>
    <p class="mt-1 text-sm text-gray-600">
      Paste text on the left. The redacted version updates automatically. Nothing is stored.
    </p>
  </header>

  <!-- Controls -->
  <section class="mb-6 rounded-lg border border-gray-200 bg-gray-50 p-4">
    <div class="space-y-4">
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">
          Always redact (optional)
        </label>
        <input
          type="text"
          class="w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
          placeholder="Comma-separated terms (e.g., client names, codenames)"
          data-redact-target="dictionary"
        />
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          class="inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-100"
          data-action="redact#run"
        >
          Redact now
        </button>

        <button
          type="button"
          class="inline-flex items-center rounded-md border border-gray-300 bg-gray-100 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-200"
          data-action="redact#clear"
        >
          Clear
        </button>

        <button
          type="button"
          class="inline-flex items-center rounded-md border border-indigo-300 bg-indigo-50 px-3 py-1.5 text-sm font-medium text-indigo-700 hover:bg-indigo-100 disabled:opacity-50 disabled:cursor-not-allowed"
          data-action="redact#copy"
          data-redact-target="copyBtn"
          disabled
        >
          Copy redacted
        </button>

        <div class="ml-auto flex items-center gap-2 text-xs">
          <span
            class="rounded-full border px-2 py-0.5 text-gray-700"
            data-redact-target="statusPill"
          >
            Idle
          </span>
          <span class="text-gray-500" data-redact-target="meta"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- Two panes -->
  <main class="grid grid-cols-1 gap-4 lg:grid-cols-2">
    <!-- Left pane -->
    <section class="flex flex-col overflow-hidden rounded-lg border border-gray-200 bg-white">
      <div class="border-b bg-gray-50 px-3 py-2 text-xs font-semibold text-gray-700">
        Original (highlights)
      </div>

      <div class="flex flex-col">
        <textarea
          class="h-80 w-full resize-y border-0 px-3 py-2 font-mono text-sm leading-relaxed focus:ring-0"
          placeholder="Paste your prompt here…"
          spellcheck="false"
          data-redact-target="input"
          data-action="input->redact#onInput"
        ></textarea>

        <pre
          class="h-80 overflow-auto border-t bg-gray-50 px-3 py-2 font-mono text-sm leading-relaxed"
          data-redact-target="highlight"
          aria-label="Highlighted original preview"
        ></pre>
      </div>

      <details class="border-t bg-gray-50 px-3 py-2 text-xs text-gray-600">
        <summary class="cursor-pointer font-medium text-gray-700">
          Tips
        </summary>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <li>Use the dictionary to force-redact client names or internal terms.</li>
          <li>Highlights show what will be replaced with placeholders.</li>
        </ul>
      </details>
    </section>

    <!-- Right pane -->
    <section class="flex flex-col overflow-hidden rounded-lg border border-gray-200 bg-white">
      <div class="border-b bg-gray-50 px-3 py-2 text-xs font-semibold text-gray-700">
        Redacted
      </div>

      <textarea
        class="h-80 w-full resize-y border-0 px-3 py-2 font-mono text-sm leading-relaxed focus:ring-0"
        placeholder="Redacted text will appear here…"
        spellcheck="false"
        readonly
        data-redact-target="output"
      ></textarea>

      <div class="border-t px-3 py-2">
        <div class="mb-2 text-xs font-semibold text-gray-700">
          Findings
        </div>

        <div
          class="space-y-2 text-xs text-gray-700"
          data-redact-target="findings"
        >
          <div class="text-gray-500">No detections yet.</div>
        </div>
      </div>
    </section>
  </main>
</div>
